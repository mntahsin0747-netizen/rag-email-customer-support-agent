    {
      "parameters": {
        "jsCode": "const email = $input.first().json;\n\nconst sender = email.from?.value?.[0]?.address || email.from || '';\nconst subject = email.subject || '';\nlet body = email.text || email.snippet || '';\n\nbody = body.split(/On .* wrote:/)[0];\nbody = body.split(/--\\s*\\n/)[0];\nbody = body.trim();\n\nreturn [{\n  json: {\n    senderEmail: sender,\n    subject,\n    customerMessage: body,\n    receivedAt: new Date().toISOString()\n  }\n}];"
      },
